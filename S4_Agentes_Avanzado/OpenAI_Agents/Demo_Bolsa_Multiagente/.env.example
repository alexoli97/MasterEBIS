# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_REASONING=gpt-5.5

# App
APP_PORT=8501
LOG_LEVEL=INFO

# Optimizer constraints (defaults; UI overrides)
MAX_WEIGHT_PER_ASSET=0.20
MIN_ASSETS=5
RISK_FREE_RATE=0.035

# Fabric SSH deploy (optional)
DEPLOY_HOST=user@host.example.com
DEPLOY_PATH=/opt/bolsa
